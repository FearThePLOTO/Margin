offset_right = -6.0
offset_bottom = 34.0
grow_horizontal = 0
theme_override_styles/panel = SubResource("SB_card")

[node name="HBox" type="HBoxContainer" parent="Root/Toast"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="ScrollIcon" type="TextureRect" parent="Root/Toast/HBox"]
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("5_scroll")
stretch_mode = 3

[node name="VBox" type="VBoxContainer" parent="Root/Toast/HBox"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Header" type="Label" parent="Root/Toast/HBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.75, 0.3, 1)
text = "NEW CHAPTER UNLOCKED!"

[node name="ToastTitle" type="Label" parent="Root/Toast/HBox/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Book of Books"

[node name="ToastKey" type="Label" parent="Root/Toast/HBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.85, 0.75, 1)
text = "B: READ NOW"

[node name="PauseMenu" parent="Root" instance=ExtResource("7_pause")]
unique_name_in_owner = true
layout_mode = 1

[node name="BookScreen" parent="Root" instance=ExtResource("6_book")]
unique_name_in_owner = true
layout_mode = 1

[node name="Sfx" type="AudioStreamPlayer" parent="."]
unique_name_in_owner = true
bus = &"SFX"
