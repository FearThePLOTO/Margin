[gd_scene format=3]

[ext_resource type="Script" path="res://src/core/ui/results_screen.gd" id="1_script"]
[ext_resource type="Theme" path="res://src/features/ui/themes/ui_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://src/core/ui/book_screen.tscn" id="3_book"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_p"]
content_margin_left = 8.0
content_margin_top = 6.0
content_margin_right = 8.0
content_margin_bottom = 6.0
bg_color = Color(0.055, 0.035, 0.07, 0.96)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.95, 0.45, 0.12, 1)

[node name="ResultsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.03, 0.02, 0.05, 1)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -130.0
offset_top = -80.0
offset_right = 130.0
offset_bottom = 80.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_p")

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="LevelTitle" type="Label" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.45, 0.12, 1)
theme_override_font_sizes/font_size = 16
text = "LEVEL 1 COMPLETE!"
horizontal_alignment = 1

[node name="Deaths" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

[node name="Label" type="Label" parent="Panel/VBox/Deaths"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "DEATHS"

[node name="DeathsValue" type="Label" parent="Panel/VBox/Deaths"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.5, 0.45, 1)
theme_override_font_sizes/font_size = 16
text = "0"

[node name="Scrolls" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 8

[node name="Label" type="Label" parent="Panel/VBox/Scrolls"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "SCROLLS"

[node name="ScrollIcons" type="HBoxContainer" parent="Panel/VBox/Scrolls"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2

[node name="ScrollCount" type="Label" parent="Panel/VBox/Scrolls"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.75, 0.3, 1)
theme_override_font_sizes/font_size = 16
text = "0/3"

[node name="Time" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

[node name="Label" type="Label" parent="Panel/VBox/Time"]
layout_mode = 2
text = "TIME"

[node name="TimeValue" type="Label" parent="Panel/VBox/Time"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.85, 0.75, 1)
text = "0:00"

[node name="FoundText" type="Label" parent="Panel/VBox"]
unique_name_in_owner = true
