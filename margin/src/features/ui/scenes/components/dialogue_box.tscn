[gd_scene format=3]

[ext_resource type="Script" path="res://src/features/ui/scripts/dialogue_box.gd" id="1_script"]
[ext_resource type="Theme" path="res://src/features/ui/themes/ui_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://src/features/ui/scripts/dialogue_continue_indicator.gd" id="3_indicator"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_story"]
content_margin_left = 3.0
content_margin_top = 3.0
content_margin_right = 3.0
content_margin_bottom = 3.0
bg_color = Color(0.055, 0.035, 0.07, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.96, 0.94, 0.9, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3
corner_detail = 1

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_portrait"]
bg_color = Color(0.16, 0.11, 0.21, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_terminal"]
content_margin_left = 6.0
content_margin_top = 3.0
content_margin_right = 6.0
content_margin_bottom = 3.0
bg_color = Color(0.02, 0.05, 0.04, 0.96)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.25, 0.85, 0.5, 1)

[node name="DialogueBox" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="FrameRoot" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -154.0
offset_top = 4.0
offset_right = 154.0
offset_bottom = 78.0
grow_horizontal = 2
mouse_filter = 2

[node name="PortraitFrame" type="PanelContainer" parent="FrameRoot"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_story")

[node name="Content" type="HBoxContainer" parent="FrameRoot/PortraitFrame"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="LeftSlot" type="PanelContainer" parent="FrameRoot/PortraitFrame/Content"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_portrait")

[node name="PortraitLeft" type="TextureRect" parent="FrameRoot/PortraitFrame/Content/LeftSlot"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
stretch_mode = 3

[node name="TextColumn" type="VBoxContainer" parent="FrameRoot/PortraitFrame/Content"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 2

[node name="NameLabel" type="Label" parent="FrameRoot/PortraitFrame/Content/TextColumn"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.45, 0.12, 1)
theme_override_font_sizes/font_size = 8
text = "NAME"

[node name="DialogueText" type="RichTextLabel" parent="FrameRoot/PortraitFrame/Content/TextColumn"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_type_variation = &"DialogueText"
theme_override_font_sizes/normal_font_size = 8
theme_override_constants/line_separation = 3
bbcode_enabled = true
text = ""
scroll_active = false
autowrap_mode = 3
visible_characters = 0
visible_characters_behavior = 1

[node name="RightSlot" type="PanelContainer" parent="FrameRoot/PortraitFrame/Content"]
visible = false
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_portrait")

[node name="PortraitRight" type="TextureRect" parent="FrameRoot/PortraitFrame/Content/RightSlot"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
stretch_mode = 3

[node name="TerminalFrame" type="PanelContainer" parent="FrameRoot"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_terminal")

[node name="VBox" type="VBoxContainer" parent="FrameRoot/TerminalFrame"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Header" type="Label" parent="FrameRoot/TerminalFrame/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.25, 0.85, 0.5, 0.65)
theme_override_font_sizes/font_size = 8
text = "NASA UPLINK :: EARTH -> MARS :: SIGNAL OK"

[node name="Rule" type="ColorRect" parent="FrameRoot/TerminalFrame/VBox"]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
mouse_filter = 2
color = Color(0.25, 0.85, 0.5, 0.35)

[node name="TermText" type="RichTextLabel" parent="FrameRoot/TerminalFrame/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_type_variation = &"DialogueText"
theme_override_colors/default_color = Color(0.5, 1, 0.65, 1)
theme_override_font_sizes/normal_font_size = 8
theme_override_constants/line_separation = 3
bbcode_enabled = true
text = ""
scroll_active = false
autowrap_mode = 3
visible_characters = 0
visible_characters_behavior = 1

[node name="ContinueIndicator" type="Control" parent="FrameRoot"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -11.0
offset_top = -9.0
offset_right = -5.0
offset_bottom = -5.0
mouse_filter = 2
script = ExtResource("3_indicator")
